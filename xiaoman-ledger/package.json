{
  "name": "xiaoman-ledger",
  "version": "2.0.0",
  "private": true,
  "description": "小满记账 · 全离线 iPhone 记账 App（Vite + Vue 3 + IndexedDB + Capacitor）",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run ios:sync && node scripts/ios_build.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "6.2.3",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "idb": "^8.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.3",
    "@capacitor/ios": "6.2.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "mermaid": "^8.8.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
